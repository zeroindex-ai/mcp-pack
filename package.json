{
  "name": "mcp-pack",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Open-source MCP servers for solo founders — Porkbun, Mercury, GitHub, Turso",
  "repository": "github:zeroindex-ai/mcp-pack",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10",
    "prettier": "^3.9.6",
    "tsx": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8.2.2",
    "vitest": "^4",
    "zod": "^4"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.6": ">=3.1.6",
      "postcss@<8.5.23": ">=8.5.23",
      "ip-address@<=10.3.0": ">=10.3.1",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7 <6",
      "hono@<4.12.25": ">=4.12.25 <5"
    }
  }
}
